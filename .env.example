# Resend (https://resend.com) API key used to send reservation emails
RESEND_API_KEY=
# Inbox that receives every reservation (article name + customer email)
RESERVATION_TO_EMAIL=
# Sender shown on the email. Must be a domain verified in Resend.
# onboarding@resend.dev works for testing (only delivers to your Resend account email).
RESERVATION_FROM_EMAIL="Parché Studio <onboarding@resend.dev>"
# Optional: public site URL for the email photo, only used if the attached photo can't be read (defaults to the Vercel production domain).
SITE_URL=
